{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/config/**/*.d.ts",
    "src/schemas/**/*.d.ts"
  ]
}
