NODE_ENV=development
BACKEND_PORT=8787
# REQUIRED: replace with a strong random secret
JWT_SECRET=replace-with-your-own-long-random-secret
# JWT issuer/audience claims for newly signed tokens.
# Leave defaults unless you need explicit cross-service coordination.
JWT_ISSUER=xyzw-web-helper-backend
JWT_AUDIENCE=xyzw-web-helper-api
# REQUIRED: replace with a strong random secret
AES_KEY=replace-with-your-own-long-random-secret
# REQUIRED: explicit secret, do not reuse JWT_SECRET
CSRF_SECRET=replace-with-your-own-long-random-secret
# REQUIRED: explicit secret, independent from JWT/CSRF and other peppers
INVITE_CODE_PEPPER=replace-with-your-own-long-random-secret
# REQUIRED: explicit secret, independent from JWT/CSRF and other peppers
ACTIVATION_CODE_PEPPER=replace-with-your-own-long-random-secret
# REQUIRED: explicit secret, independent from JWT/CSRF and other peppers
PASSWORD_RESET_CODE_PEPPER=replace-with-your-own-long-random-secret
# REQUIRED in production: set explicit HTTPS origins only, never localhost/loopback.
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# REQUIRED in production: explicit public application origin used in links/notices. Must be HTTPS.
PUBLIC_APP_ORIGIN=https://app.example.com
# REQUIRED in production: explicit admin application origin used for admin reset links. Must be HTTPS.
ADMIN_APP_ORIGIN=https://admin.example.com
# Optional: WeChat Open Platform website login config for account bind/login.
# Redirect URI should point to your deployed backend callback endpoint, for example:
# https://app.example.com/api/v1/auth/wechat/callback
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=
# CSP connect-src allowlist (comma-separated). Avoid broad schemes like https: / wss:.
# Default (if omitted): https://*.hortorgames.com,wss://*.hortorgames.com
CSP_CONNECT_SRC=https://*.hortorgames.com,wss://*.hortorgames.com
# Trusted host allowlist for backend token-import proxy (comma-separated).
# Supports exact host and leading-dot suffix patterns, e.g. api.example.com,.example.com
# Keep this in sync with frontend VITE_TRUSTED_IMPORT_API_HOSTS.
# Development/test default (if omitted): localhost,127.0.0.1,::1,[::1]
# Production default (if omitted): empty allowlist, proxy fail-closed
# Production must set this explicitly and must not include localhost/127.0.0.1/::1/[::1]
TRUSTED_IMPORT_API_HOSTS=
# token-import proxy upstream timeout / max response bytes
TOKEN_IMPORT_PROXY_TIMEOUT_MS=15000
TOKEN_IMPORT_PROXY_RESPONSE_MAX_BYTES=1048576
# Optional: comma-separated usernames/emails that should be protected from issuing short reset codes.
PROTECTED_ADMIN_IDENTITIES=
# Optional: express trust proxy setting. Default is "loopback, linklocal, uniquelocal".
# Example (single reverse proxy hop): TRUST_PROXY=1
# Example (specific proxy subnet): TRUST_PROXY=10.0.0.0/8
TRUST_PROXY=loopback, linklocal, uniquelocal
# Legacy Flask must not trust proxy headers by default.
LEGACY_TRUST_PROXY=false
# Do not keep BOOTSTRAP_ADMIN_* in runtime env. Use `npm --prefix backend run init-admin` once instead.
LOG_REQUESTS=true
METRICS_ENABLED=true
# DB 写入安全日志（默认最小化：只记元信息，不含 SQL/params）
DB_WRITE_SAFETY_LOG_ENABLED=true
# 仅在排障短期开启，避免扩大敏感数据落盘面
DB_WRITE_SAFETY_INCLUDE_SQL=false
# 允许记录 params 的表白名单（逗号分隔，默认空）
DB_WRITE_SAFETY_PARAMS_TABLES=
# params 字符串最大长度（超长自动截断）
DB_WRITE_SAFETY_PARAM_MAX_LEN=120
# Application-level SQLite plaintext backup.
# Keep this false by default. In production, only enable by explicit opt-in if you fully accept
# the plaintext backup risk and cannot rely on encrypted infra snapshots/backups.
APP_DB_BACKUP_ENABLED=false
DB_PATH=./data/xyzw.sqlite.bin
BIN_STORAGE_PATH=./data/bin-storage
# Backend 错误日志落盘（权限 + 大小轮转）
BACKEND_ERROR_LOG_PATH=./data/backend-errors.log
# 单文件最大字节数（默认 5MB，达到后轮转为 .1/.2/...）
BACKEND_ERROR_LOG_MAX_BYTES=5242880
# 保留轮转文件数量（不含当前文件）
BACKEND_ERROR_LOG_MAX_FILES=5
# 文件权限（八进制）
BACKEND_ERROR_LOG_FILE_MODE=600
# 目录权限（八进制）
BACKEND_ERROR_LOG_DIR_MODE=700
ACCESS_TOKEN_TTL_SECONDS=600
# Must stay false in production.
ACCESS_TOKEN_EXPOSE_IN_BODY=false
# Production default is false. Set to true only during the one-release migration window
# if you still need Authorization Bearer or WebSocket auth/reauth token-frame compatibility.
ALLOW_BEARER_AUTH_LEGACY=true
ACCESS_COOKIE_NAME=xyzw_access_token
ACCESS_COOKIE_PATH=/
# Optional: restrict access cookie to a specific host/subdomain (e.g. admin.example.com).
# Leave empty to use host-only cookie bound to current response host.
ACCESS_COOKIE_DOMAIN=
# strict | lax | none
ACCESS_COOKIE_SAMESITE=lax
# In production this should be true (HTTPS only).
# Runtime hardening: when request is HTTPS (or X-Forwarded-Proto=https), backend will force Secure anyway.
ACCESS_COOKIE_SECURE=false
REFRESH_TOKEN_TTL_DAYS=14
# Session policy for login "remember me":
# - unchecked uses short TTL (default 3 days, suggested 1-3)
# - checked uses long TTL (default 14 days, suggested 14-30)
REFRESH_TOKEN_SHORT_TTL_DAYS=3
REFRESH_TOKEN_LONG_TTL_DAYS=14
REFRESH_COOKIE_NAME=xyzw_refresh_token
# If REFRESH_COOKIE_NAME uses __Host- prefix, this must be "/".
REFRESH_COOKIE_PATH=/api/v1/auth
# Optional: restrict refresh cookie to a specific host/subdomain.
REFRESH_COOKIE_DOMAIN=
# strict | lax | none
REFRESH_COOKIE_SAMESITE=lax
# In production this should be true (HTTPS only).
# Runtime hardening: when request is HTTPS (or X-Forwarded-Proto=https), backend will force Secure anyway.
REFRESH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=xyzw_csrf_token
CSRF_SESSION_COOKIE_NAME=xyzw_csrf_session
# Optional: restrict CSRF cookies to a specific host/subdomain.
CSRF_COOKIE_DOMAIN=
# strict | lax | none
CSRF_COOKIE_SAMESITE=lax
# In production this should be true (HTTPS only).
# Runtime hardening: when request is HTTPS (or X-Forwarded-Proto=https), backend will force Secure anyway.
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_TTL_DAYS=14
# Header name checked by backend on state-changing requests.
CSRF_HEADER_NAME=x-csrf-token

# Public SSE stream capacity guardrails
PUBLIC_WECHAT_CONTACTS_SSE_MAX_GLOBAL=50
PUBLIC_WECHAT_CONTACTS_SSE_MAX_PER_IP=3

# WebSocket capacity guardrails
WS_MAX_GLOBAL_CONNECTIONS=200
WS_MAX_CONNECTIONS_PER_IP=10
WS_MAX_CONNECTIONS_PER_USER=5

# Task-control backend scheduler: custom wsUrl is disabled by default.
# Set to true only when you need custom wsUrl and have a strict allowlist.
TASK_CONTROL_CUSTOM_WS_URL_ENABLED=false
# wechat proxy upstream timeout / max response bytes
WECHAT_PROXY_TIMEOUT_MS=15000
WECHAT_PROXY_RESPONSE_MAX_BYTES=524288
# Comma-separated host/domain allowlist for custom wsUrl (wss:// only).
# Use ".example.com" to allow all subdomains.
TASK_CONTROL_CUSTOM_WS_URL_ALLOWLIST=hortorgames.com,.hortorgames.com

# Unified log cleanup policy (days)
LOG_CLEANUP_TASK_CONTROL_DAYS=30
LOG_CLEANUP_TASK_RUNS_DAYS=60
LOG_CLEANUP_BIN_DOWNLOAD_AUDITS_DAYS=90
LOG_CLEANUP_BIN_DOWNLOAD_TICKETS_DAYS=14
LOG_CLEANUP_READ_NOTIFICATIONS_DAYS=90
LOG_CLEANUP_SECURITY_EVENTS_DAYS=180
LOG_CLEANUP_ADMIN_AUDIT_DAYS=365
# Daily cleanup execution time (server local timezone)
LOG_CLEANUP_HOUR=3
LOG_CLEANUP_MINUTE=20

# Password leakage check (HIBP k-Anon). Disabled by default.
# When enabled, backend queries the hash prefix API and blocks leaked passwords.
PASSWORD_HIBP_ENABLED=false
PASSWORD_HIBP_API_BASE_URL=https://api.pwnedpasswords.com/range
PASSWORD_HIBP_TIMEOUT_MS=2500
